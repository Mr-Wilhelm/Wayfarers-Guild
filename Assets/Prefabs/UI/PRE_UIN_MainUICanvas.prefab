  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'The Drill-Beaked Cranes are a highly territorial avian species found in
    flocks throughout The Outer Realms. Drill-beaked cranes attack by dive bombing
    their targets, then twisting their flexible necks in a corkscrew motion to drill
    the beak in further. They can be seen with a bright green ectoplasmic lichen
    across their bodies, which is able to attract static, giving the cranes the capability
    to blow fuses in ships they attack. Drill-beaks, while aggressive, tend not to
    attack unless their territory, or their flock, are endangered.

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: cdb2661bf4589ed468c40bf0073ce072, type: 2}
  m_sharedMaterial: {fileID: 1058936486334977727, guid: cdb2661bf4589ed468c40bf0073ce072,
