  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Tulebreathers get their name from the thick, dense fog (named tule fog)
    they are capable of producing, primarily as a defence mechanism. They tend to
    see passing ships as passive beings of the same plane as them, and even seem
    to travel alongside smaller ships, seeing them as children in need of protection.
    The Tulebreather presents little threat to any ship passing by it, and their
    fog can even be used as cover from passing creatures. To do this, it is best
    to use a sonar ping to get their attention, as they will recognise it as a call
    and respond by moving towards the ship

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: cdb2661bf4589ed468c40bf0073ce072, type: 2}
